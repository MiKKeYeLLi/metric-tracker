generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleType {
  NewsArticle
  Interview
  FeatureStory
  PressRelease
  OpinionCommentary
  PartnerSponsoredContent
  BroadcastPodcastAppearance
  Other
}

enum SubmissionStatus {
  Draft
  Submitted
  UnderReview
  ChangesRequested
  Accepted
  Published
  Rejected
  Withdrawn
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  contentItems  ContentItem[]
  seoChecks     SeoCheck[]
}

model ContentItem {
  id          String   @id @default(cuid())
  userId      String
  title       String
  url         String
  type        String
  platform    String
  topics      String[] @default([])
  status      String
  createdDate DateTime @db.Date
  publishDate DateTime? @db.Date
  updatedDate DateTime? @db.Date
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdDate])
  @@index([userId, status])
}

model PressCoverage {
  id                  String           @id @default(cuid())
  title              String
  outlet             String
  articleType        ArticleType
  articleTypeOther   String?
  publishedArticleUrl String?
  publicationDate    DateTime?
  summary            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  submissions        PressSubmission[]
}

model PressSubmission {
  id                  String           @id @default(cuid())
  title              String
  outlet             String
  articleType        ArticleType
  articleTypeOther   String?
  status             SubmissionStatus @default(Draft)
  dateSubmitted      DateTime
  responsiblePerson  String?
  followUpDate       DateTime?
  draftUrl           String?
  publishedArticleUrl String?
  notes              String?
  coverageId         String?
  coverage           PressCoverage?   @relation(fields: [coverageId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SeoCheck {
  id             String   @id @default(cuid())
  url            String
  normalizedUrl  String
  score          Int
  categoryScores Json
  snapshot       Json
  results        Json
  errorCount     Int
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([normalizedUrl, createdAt])
}

enum DirectoryStatus {
  NotSubmitted
  PendingReview
  NeedsChanges
  Live
  Rejected
}

enum DirectoryPriority {
  High
  Medium
  Low
}

model Directory {
  id             String                   @id @default(cuid())
  name           String
  website        String
  status         DirectoryStatus          @default(NotSubmitted)
  priority       DirectoryPriority        @default(Medium)
  dateSubmitted  DateTime?                @db.Date
  listingUrl     String?
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  activities     DirectoryActivity[]
  checklistItems DirectoryChecklistItem[]

  @@index([status])
}

/// A team-wide log of directory changes. Stores the directory's name so entries survive its deletion.
model DirectoryActivity {
  id            String           @id @default(cuid())
  directoryId   String?
  directory     Directory?       @relation(fields: [directoryId], references: [id], onDelete: SetNull)
  directoryName String
  message       String
  status        DirectoryStatus?
  createdAt     DateTime         @default(now())

  @@index([createdAt])
}

model DirectoryChecklistItem {
  id          String    @id @default(cuid())
  directoryId String
  directory   Directory @relation(fields: [directoryId], references: [id], onDelete: Cascade)
  label       String
  done        Boolean   @default(false)
  isDefault   Boolean   @default(false)
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([directoryId, position])
}

/// Team-wide reusable text for directory submissions (taglines, descriptions).
model SavedCopy {
  id        String   @id @default(cuid())
  label     String
  text      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}
