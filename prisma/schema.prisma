generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  contentItems  ContentItem[]
  seoChecks     SeoCheck[]
}

model ContentItem {
  id          String   @id @default(cuid())
  userId      String
  title       String
  url         String
  type        String
  platform    String
  topics      String[] @default([])
  status      String
  createdDate DateTime @db.Date
  publishDate DateTime? @db.Date
  updatedDate DateTime? @db.Date
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdDate])
  @@index([userId, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SeoCheck {
  id             String   @id @default(cuid())
  url            String
  normalizedUrl  String
  score          Int
  categoryScores Json
  snapshot       Json
  results        Json
  errorCount     Int
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([normalizedUrl, createdAt])
}
