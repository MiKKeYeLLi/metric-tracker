generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleType {
  NewsArticle
  Interview
  FeatureStory
  PressRelease
  OpinionCommentary
  PartnerSponsoredContent
  BroadcastPodcastAppearance
  Other
}

enum SubmissionStatus {
  Draft
  Submitted
  UnderReview
  ChangesRequested
  Accepted
  Published
  Rejected
  Withdrawn
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  contentItems  ContentItem[]
  seoChecks     SeoCheck[]
  createdTasks  Task[]        @relation("TaskCreator")
  assignedTasks Task[]        @relation("TaskOwner")
  agents        Agent[]
  isPlatformAdmin Boolean     @default(false) @map("is_platform_admin")
  ledgerEntries PointsLedger[]
}

model ContentItem {
  id          String    @id @default(cuid())
  userId      String
  title       String?
  url         String?
  type        String?
  platform    String?
  topics      String[]  @default([])
  status      String
  createdDate DateTime  @db.Date
  publishDate DateTime? @db.Date
  updatedDate DateTime? @db.Date
  views       Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdDate])
  @@index([userId, status])
}

model PressCoverage {
  id                  String            @id @default(cuid())
  title               String
  outlet              String
  articleType         ArticleType?
  articleTypeOther    String?
  publishedArticleUrl String?
  publicationDate     DateTime?
  summary             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  submissions         PressSubmission[]
  outletId            String?
  pressOutlet         PressOutlet?      @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([outletId])
}

model PressSubmission {
  id                  String           @id @default(cuid())
  title               String
  outlet              String
  articleType         ArticleType?
  articleTypeOther    String?
  status              SubmissionStatus @default(Draft)
  dateSubmitted       DateTime?
  responsiblePerson   String?
  followUpDate        DateTime?
  draftUrl            String?
  publishedArticleUrl String?
  notes               String?
  coverageId          String?
  coverage            PressCoverage?   @relation(fields: [coverageId], references: [id], onDelete: SetNull)
  outletId            String?
  pressOutlet         PressOutlet?     @relation(fields: [outletId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SeoCheck {
  id             String   @id @default(cuid())
  url            String
  normalizedUrl  String
  score          Int
  categoryScores Json
  snapshot       Json
  results        Json
  errorCount     Int
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([normalizedUrl, createdAt])
}

model SeoSettings {
  id        String   @id @default("workspace")
  pageUrl   String
  updatedAt DateTime @updatedAt
}

enum DirectoryStatus {
  NotSubmitted
  PendingReview
  NeedsChanges
  Live
  Rejected
}

enum DirectoryPriority {
  High
  Medium
  Low
}

model Directory {
  id             String                   @id @default(cuid())
  name           String
  website        String
  status         DirectoryStatus          @default(NotSubmitted)
  priority       DirectoryPriority        @default(Medium)
  dateSubmitted  DateTime?                @db.Date
  listingUrl     String?
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  activities     DirectoryActivity[]
  checklistItems DirectoryChecklistItem[]

  @@index([status])
}

/// A team-wide log of directory changes. Stores the directory's name so entries survive its deletion.
model DirectoryActivity {
  id            String           @id @default(cuid())
  directoryId   String?
  directory     Directory?       @relation(fields: [directoryId], references: [id], onDelete: SetNull)
  directoryName String
  message       String
  status        DirectoryStatus?
  createdAt     DateTime         @default(now())

  @@index([createdAt])
}

model DirectoryChecklistItem {
  id          String    @id @default(cuid())
  directoryId String
  directory   Directory @relation(fields: [directoryId], references: [id], onDelete: Cascade)
  label       String
  done        Boolean   @default(false)
  isDefault   Boolean   @default(false)
  position    Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([directoryId, position])
}

/// Team-wide reusable text for directory submissions (taglines, descriptions).
model SavedCopy {
  id        String   @id @default(cuid())
  label     String
  text      String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

enum OutletTier {
  Tier1
  Tier2
  Tier3
}

/// One media outlet, shared by every piece of coverage and pitch for it. `key` is the name with case,
/// spaces and punctuation removed, so "TechCabal" and "Tech Cabal" are one outlet.
model PressOutlet {
  id           String            @id @default(cuid())
  name         String
  key          String            @unique
  website      String?
  contactName  String?
  contactEmail String?
  tier         OutletTier?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  coverage     PressCoverage[]
  submissions  PressSubmission[]
}

enum TaskType {
  Call
  Email
  FollowUp
  Meeting
  Other
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        TaskType  @default(Other)
  dueAt       DateTime
  done        Boolean   @default(false)
  completedAt DateTime?
  ownerId     String?
  owner       User?     @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  userId      String
  user        User      @relation("TaskCreator", fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([dueAt])
  @@index([userId, done])
  @@index([ownerId])
}

// An AI agent a user connects to the platform. The plain key is shown once at creation; only its hash is stored.
model Agent {
  id           String    @id @default(cuid())
  name         String
  speciality   String
  description  String?
  avatarStyle  String
  avatarSeed   String
  keyHash      String    @unique
  keyHint      String
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  connectedAt  DateTime?
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  ledgerEntries PointsLedger[]

  @@index([ownerId])
}

// Points-bearing task categories, managed by platform admins. Snake_case columns
// per the PR 5 schema request (doc/points-schema-requests.md); archived via is_active.
model TaskTypeDef {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  points      Int
  maxPoints   Int      @map("max_points")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("task_types")
}

// Seeded config rows: how many points each reason pays and whether it's on.
model PointRule {
  ruleKey   String  @id @map("rule_key")
  amount    Int
  enabled   Boolean @default(false)
  weeklyCap Int?    @map("weekly_cap")

  @@map("point_rules")
}

// Append-only points ledger. Balance is SUM(amount); never stored. Negative amounts
// are reversals/adjustments. idempotency_key makes double-awards impossible.
model PointsLedger {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  agentId         String?  @map("agent_id")
  projectId       String   @map("project_id")
  amount          Int      @map("amount")
  reason          String   @map("reason")
  sourceType      String?  @map("source_type")
  sourceId        String?  @map("source_id")
  idempotencyKey  String   @unique @map("idempotency_key")
  grantedByUserId String?  @map("granted_by_user_id")
  note            String?  @map("note")
  createdAt       DateTime @default(now()) @map("created_at")

  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([reason, createdAt])
  @@map("points_ledger")
}
