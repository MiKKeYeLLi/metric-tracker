{
  "name": "metric-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node api.js && next dev",
    "build": "node api.js && prisma generate && next build",
    "start": "node api.js && next start -p ${PORT:-3000}",
